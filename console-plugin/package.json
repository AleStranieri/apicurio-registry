{
  "name": "apicurio-registry-console-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "OpenShift Console dynamic plugin for Apicurio Registry",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && NODE_ENV=production webpack && cp -r locales dist/locales",
    "dev": "webpack serve",
    "start": "npm run dev",
    "start-console": "./start-console.sh",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "i18n": "i18next 'src/**/*.{js,jsx,ts,tsx}' [-oc] -c i18next-parser.config.js",
    "test:apitomy-poc": "node tests/verify-apitomy-poc.cjs",
    "test:openapi-ai": "G5_CONSOLE_TEST=1 node ../ui/ui-app/node_modules/vitest/vitest.mjs run --root ../ui/ui-app src/editors/OpenApiProposalClient.test.ts src/editors/OpenApiAiPanel.test.tsx src/editors/OpenApiEditor.test.tsx"
  },
  "devDependencies": {
    "@microsoft/kiota-abstractions": "1.0.0-preview.110",
    "@microsoft/kiota-http-fetchlibrary": "1.0.0-preview.110",
    "@openshift-console/dynamic-plugin-sdk": "4.20.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.20.0",
    "@patternfly/react-core": "6.6.1",
    "@patternfly/react-icons": "6.6.1",
    "@patternfly/react-table": "6.6.1",
    "@swc/core": "^1.15.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "~5.3.0",
    "ajv": "^8.17.0",
    "css-loader": "^7.1.0",
    "eslint": "^9.7.0",
    "i18next-parser": "^9.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "~11.18.0",
    "react-router-dom": "~5.3.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.9.0",
    "webpack": "^5.107.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.0"
  },
  "consolePlugin": {
    "name": "apicurio-registry",
    "version": "1.0.0",
    "displayName": "Apicurio Registry",
    "description": "OpenShift Console plugin for managing Apicurio Registry instances",
    "exposedModules": {
      "RegistryListPage": "./components/RegistryListPage",
      "RegistryDetailPage": "./components/RegistryDetailPage",
      "RegistryWorkspacePage": "./components/RegistryWorkspacePage"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  }
}
